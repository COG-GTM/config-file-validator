# --schema-map with exact filename match
exec validator --schema-map=config.json:schema.json config.json
stdout '✓'

# --schema-map with invalid data fails
! exec validator --schema-map=bad.json:schema.json bad.json
stdout '×'
stdout 'error:'

# --schema-map with glob pattern
exec validator --schema-map=**/*.json:schema.json subdir/config.json
stdout '✓'

# --schema-map does not affect unmatched files
exec validator --schema-map=config.json:schema.json other.json
stdout '✓'

# --schema-map warns and still passes when matched file type has no schema support
exec validator --schema-map=.env:schema.json .env
stdout '✓'
stdout 'warning: --schema-map matched this file'

# --schema-map fails unsupported schema validators when schema is required
! exec validator --require-schema --schema-map=.env:schema.json .env
stdout '×'
stdout 'error: schema: --schema-map matched this file'
! stdout 'warning: --schema-map matched this file'

# --schema-map is enforced even when the document declares its own $schema
! exec validator --schema-map=with_schema.json:strict_schema.json with_schema.json
stdout '×'

# A document cannot swap the mapped schema for a permissive one
! exec validator --schema-map=deploy.json:strict_schema.json deploy.json
stdout '×'
! exec validator --require-schema --schema-map=deploy.json:strict_schema.json deploy.json
stdout '×'

# Document $schema still applies alongside a matching --schema-map
exec validator --schema-map=with_schema.json:schema.json with_schema.json
stdout '✓'
! exec validator --schema-map=bad_own.json:schema.json bad_own.json
stdout '×'

# Invalid --schema-map format
! exec validator --schema-map=badformat .
stderr 'invalid schema-map format'

-- schema.json --
{
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" }
  },
  "additionalProperties": false
}
-- strict_schema.json --
{
  "type": "object",
  "required": ["host"],
  "properties": {
    "host": { "type": "string" }
  },
  "additionalProperties": false
}
-- config.json --
{"name": "test", "version": "1.0"}
-- bad.json --
{"name": 123}
-- subdir/config.json --
{"name": "nested", "version": "2.0"}
-- other.json --
{"anything": "goes"}
-- .env --
KEY=VALUE
-- with_schema.json --
{
  "$schema": "schema.json",
  "name": "test",
  "version": "1.0"
}
-- loose.json --
{}
-- deploy.json --
{
  "$schema": "loose.json",
  "debug": true
}
-- own_strict.json --
{
  "type": "object",
  "properties": {
    "version": { "type": "string", "pattern": "^2\\." }
  }
}
-- bad_own.json --
{
  "$schema": "own_strict.json",
  "name": "test",
  "version": "1.0"
}
